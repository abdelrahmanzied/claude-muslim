{
  "name": "claude-muslim",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "claude plugin test plugin",
    "validate": "claude plugin validate . && claude plugin validate plugin",
    "license": "node -e \"const f=require('fs');if(!f.readFileSync('LICENSE').equals(f.readFileSync('plugin/LICENSE'))){console.error('LICENSE and plugin/LICENSE differ');process.exit(1)}\"",
    "check": "npm run license && npm run validate && npm run test && npm run typecheck",
    "visual": "node scripts/visual/run.ts",
    "fonts": "node scripts/fonts/coverage.ts"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
